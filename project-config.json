    "test_e2e": "npm run test:e2e",
    "format_check": "npx prettier --check .",
    "format_fix": "npx prettier --write .",
    "build": "npm run build",
    "quality_gate": "make q.check",
    "quality_check": "make q.check"
  },
  "styling": {
    "framework": "tailwind",
    "preprocessor": "postcss"
  },
  "stack": {
