{
  "name": "sitright",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "buddypia <contact@buddypia.com>",
  "engines": {
    "node": "^24.21.0"
  },
  "scripts": {
    "predev": "node scripts/copy-mediapipe-wasm.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-mediapipe-wasm.mjs",
    "build": "next build",
    "postbuild": "node scripts/postbuild.mjs",
    "preview": "wrangler pages dev out --port 3011",
    "deploy": "npm run build && wrangler pages deploy out --project-name sitright --branch main",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "analytics": "node scripts/cf-analytics.mjs",
    "check:harness": "node scripts/check-agent-harness.mjs",
    "harness:index": "node scripts/harness-library.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.0",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.4",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
