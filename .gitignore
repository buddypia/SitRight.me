# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ClaudPoint checkpoint system
.checkpoints/

# local test media / scratch
/public/dev/
/.tmp/
/tmp/
/test-results/
/playwright-report/
/.playwright-cli/
# .agents/ はエージェントのローカル作業場所。skill（.claude/skills への symlink）と Antigravity の hook 登録（hooks.json）だけコミットする。
# hooks.json を無視すると worktree に届かず、そこでは hook が動かない
/.agents/*
!/.agents/skills/
!/.agents/hooks.json
/tests/e2e/fixtures/*.mjpeg
/tests/e2e/fixtures/portrait.jpg

# local tooling
/.claude/settings.local.json

# copied from node_modules by scripts/copy-mediapipe-wasm.mjs
/public/mediapipe/wasm/
/.wrangler/

# --- brief2dev transplant-bundle (auto-managed block) ---
.worktrees/
.tmp/
.cache/
.brief2dev/
.claude/state/
.claude/.transplant-backup/
# --- end brief2dev transplant-bundle ---
