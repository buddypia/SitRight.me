{
  "schema_version": 2,
  "skill_id": "feature-spec-generator",
  "tier": 2,
  "tier_description": "Pipeline - Generates SPEC.md + Screen documents based on CONTEXT.json",
  "enforced_protocol": {
    "version": "2.0",
    "preflight_required": false,
    "postflight_required": false,
    "model_routing_required": false,
    "evidence_caching_enabled": false
  },
  "model_routing": {
    "default_model": "sonnet",
    "task_specific": {
      "context_reading": "sonnet",
      "spec_generation": "sonnet",
      "screen_wireframe": "sonnet"
    },
    "fallback_chain": [
      "sonnet"
    ]
  },
  "evidence_policy": {
    "note": "SPEC generation is based on CONTEXT.json. Generates fresh documents on each run"
  },
  "public_api": {
    "direct_invocable": true,
    "trigger_keywords": [
      "generate spec",
      "write spec",
      "create specification",
      "generate specification"
    ],
    "args_pattern": "<feature-id> [--req <additional requirements>]"
  },
  "dependencies": {
    "required": [
      "feature-architect"
    ],
    "optional": []
  },
  "called_by": [
    "feature-pilot",
    "feature-architect"
  ],
  "calls": [],
  "outputs": [
    {
      "type": "file",
      "path_pattern": "docs/features/<id>-<name>/SPEC-<id>-<name>.md",
      "description": "Feature specification document"
    },
    {
      "type": "directory",
      "path_pattern": "docs/features/<id>-<name>/screens/",
      "description": "Screen documents directory"
    },
    {
      "type": "file",
      "path_pattern": "docs/features/<id>-<name>/screens/*.md",
      "description": "Individual screen documents"
    }
  ],
  "state_transitions": {
    "context_json_field": "quick_resume.current_state",
    "valid_transitions": [
      {
        "from": "SpecDrafting",
        "to": "SpecDrafting"
      }
    ]
  },
  "ssot_files": [],
  "references": [
    {
      "file": "references/error-rescue-map-template.md",
      "description": "Error & Rescue Map template. Defines per-screen error states + recovery paths. Transplanted from gstack plan-ceo-review.",
      "transplant_source": "tp-gstack-20260325"
    },
    {
      "file": "references/interaction-state-coverage-template.md",
      "description": "Interaction state coverage template. Per-component state matrix. Transplanted from gstack plan-design-review.",
      "transplant_source": "tp-gstack-20260325"
    },
    {
      "file": "references/spec-generation-protocol-details.md",
      "description": "Long-form SPEC generation protocol archive. Read on-demand when detailed question lists, API/NFR templates, and parallel implementation guide examples are needed."
    }
  ]
}
