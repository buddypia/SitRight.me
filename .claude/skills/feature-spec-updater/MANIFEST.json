{
  "schema_version": 2,
  "skill_id": "feature-spec-updater",
  "tier": 2,
  "tier_description": "Pipeline - Modifies existing SPEC documents with full audit trail",
  "enforced_protocol": {
    "version": "2.0",
    "preflight_required": false,
    "postflight_required": false,
    "model_routing_required": false,
    "evidence_caching_enabled": false
  },
  "model_routing": {
    "default_model": "sonnet",
    "task_specific": {
      "spec_loading": "sonnet",
      "diff_analysis": "sonnet",
      "spec_modification": "sonnet"
    },
    "fallback_chain": [
      "sonnet"
    ]
  },
  "evidence_policy": {
    "note": "SPEC updates record revision history directly. Caching unnecessary."
  },
  "public_api": {
    "direct_invocable": true,
    "trigger_keywords": [
      "SPEC update",
      "update SPEC",
      "feature modification",
      "add FR",
      "modify FR"
    ],
    "args_pattern": "<feature-id> [--add-fr <description>] [--modify <FR-XXXXX> <description>] [--section <section>]"
  },
  "dependencies": {
    "required": [],
    "optional": []
  },
  "called_by": [
    "feature-pilot"
  ],
  "calls": [],
  "outputs": [
    {
      "type": "file",
      "path_pattern": "docs/features/*/SPEC-*.md",
      "description": "Updated SPEC document"
    },
    {
      "type": "file",
      "path_pattern": "docs/features/*/screens/*.md",
      "description": "Updated Screen documents"
    },
    {
      "type": "state_update",
      "path_pattern": "docs/features/*/CONTEXT.json",
      "description": "Updates to decisions and history sections"
    }
  ],
  "state_transitions": {
    "context_json_field": "quick_resume.current_state",
    "valid_transitions": [
      {
        "from": "Idle",
        "to": "SpecUpdating"
      },
      {
        "from": "SpecUpdating",
        "to": "SpecUpdating"
      }
    ]
  },
  "ssot_files": []
}
